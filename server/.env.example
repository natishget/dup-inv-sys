# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/inventory?schema=public"

# NestJS Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Configuration
JWT_ACCESS_SECRET="change-this-to-a-secure-random-32-byte-hex-or-base64-secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="change-this-to-a-secure-random-32-byte-hex-or-base64-secret"
JWT_REFRESH_EXPIRATION="7d"

# Throttler Configuration
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5

# Cookie & Session Security
COOKIE_SECRET="change-this-to-a-secure-cookie-secret"
