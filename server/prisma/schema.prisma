datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  SALES
  AUDITOR
}

enum ProductOrigin {
  LOCAL
  IMPORTED
}

enum CostingMethodName {
  FIFO
  LIFO
  WEIGHTED_AVERAGE
}

enum TransactionStatus {
  POSTED
  VOIDED
}

enum TransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  SALE_RETURN
  PURCHASE_RETURN
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String                 @db.VarChar(255)
  phone                 String                 @unique @db.VarChar(255)
  email                 String                 @unique @db.VarChar(255)
  emailVerifiedAt       DateTime?              @map("email_verified_at") @db.Timestamp(6)
  role                  UserRole               @default(SALES)
  isActive              Boolean                @default(true) @map("is_active")
  password              String                 @db.VarChar(255)
  rememberToken         String?                @map("remember_token") @db.VarChar(100)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamp(6)

  purchases             Purchase[]             @relation("PurchaseCreatedBy")
  sales                 Sale[]                 @relation("SaleCreatedBy")
  inventoryTransactions InventoryTransaction[] @relation("InventoryTransactionCreatedBy")

  @@map("users")
}

model Product {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @db.VarChar(255)
  baseUnit  String?          @map("base_unit") @db.VarChar(50)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(6)

  variants  ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id                    String                 @id @default(uuid()) @db.Uuid
  productId             String?                @map("product_id") @db.Uuid
  color                 String?                @db.VarChar(50)
  origin                ProductOrigin?
  sku                   String?                @unique @db.VarChar(100)
  thickness             Decimal?               @db.Decimal(10, 2)
  size                  String?                @db.VarChar(100)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamp(6)

  product               Product?               @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItems         PurchaseItem[]
  saleItems             SaleItem[]
  inventoryTransactions InventoryTransaction[]
  inventoryCostLayers   InventoryCostLayer[]
  inventoryValuations   InventoryValuation[]
  cogsEntries           CogsEntry[]

  @@index([productId])
  @@map("product_variants")
}

model Warehouse {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String?                @db.VarChar(100)
  location              String?                @db.Text

  inventoryTransactions InventoryTransaction[]
  inventoryCostLayers   InventoryCostLayer[]
  inventoryValuations   InventoryValuation[]

  @@map("warehouses")
}

model CostingMethod {
  id             String            @id @default(uuid()) @db.Uuid
  name           CostingMethodName @unique

  systemSettings SystemSetting[]

  @@map("costing_methods")
}

model SystemSetting {
  id                   String         @id @default(uuid()) @db.Uuid
  activeCostingMethodId String?       @map("active_costing_method") @db.Uuid

  costingMethod        CostingMethod? @relation(fields: [activeCostingMethodId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model Purchase {
  id            String            @id @default(uuid()) @db.Uuid
  supplierName  String?           @map("supplier_name") @db.VarChar(255)
  invoiceNumber String?           @map("invoice_number") @db.VarChar(100)
  totalAmount   Decimal?          @map("total_amount") @db.Decimal(14, 2)
  purchaseDate  DateTime?         @map("purchase_date") @db.Date
  status        TransactionStatus @default(POSTED)
  referenceType String?           @map("reference_type") @db.VarChar(20)
  referenceId   String?           @map("reference_id") @db.Uuid
  notes         String?           @db.Text
  createdById   String?           @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(6)

  createdBy     User?             @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items         PurchaseItem[]

  @@index([status])
  @@index([referenceId])
  @@index([createdById])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         String          @id @default(uuid()) @db.Uuid
  purchaseId String?         @map("purchase_id") @db.Uuid
  variantId  String?         @map("variant_id") @db.Uuid
  quantity   Decimal?        @db.Decimal(14, 4)
  unitCost   Decimal?        @map("unit_cost") @db.Decimal(14, 4)
  totalCost  Decimal?        @map("total_cost") @db.Decimal(14, 2)

  purchase   Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([variantId])
  @@map("purchase_items")
}

model Sale {
  id            String            @id @default(uuid()) @db.Uuid
  customerName  String?           @map("customer_name") @db.VarChar(255)
  totalAmount   Decimal?          @map("total_amount") @db.Decimal(14, 2)
  saleDate      DateTime?         @map("sale_date") @db.Date
  status        TransactionStatus @default(POSTED)
  referenceType String?           @map("reference_type") @db.VarChar(20)
  referenceId   String?           @map("reference_id") @db.Uuid
  notes         String?           @db.Text
  createdById   String?           @map("created_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(6)

  createdBy     User?             @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items         SaleItem[]

  @@index([saleDate])
  @@index([status])
  @@index([referenceId])
  @@index([createdById])
  @@map("sales")
}

model SaleItem {
  id           String          @id @default(uuid()) @db.Uuid
  saleId       String?         @map("sale_id") @db.Uuid
  variantId    String?         @map("variant_id") @db.Uuid
  quantity     Decimal?        @db.Decimal(14, 4)
  sellingPrice Decimal?        @map("selling_price") @db.Decimal(14, 4)
  totalPrice   Decimal?        @map("total_price") @db.Decimal(14, 2)

  sale         Sale?           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  cogsEntries  CogsEntry[]

  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

model InventoryTransaction {
  id              String           @id @default(uuid()) @db.Uuid
  variantId       String?          @map("variant_id") @db.Uuid
  warehouseId     String?          @map("warehouse_id") @db.Uuid
  transactionType TransactionType? @map("transaction_type")
  quantity        Decimal?         @db.Decimal(14, 4)
  unitCost        Decimal?         @map("unit_cost") @db.Decimal(14, 4)
  referenceType   String?          @map("reference_type") @db.VarChar(50)
  referenceId     String?          @map("reference_id") @db.Uuid
  transactionDate DateTime?        @map("transaction_date") @db.Date
  createdById     String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(6)

  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy       User?            @relation("InventoryTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([warehouseId])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([referenceId])
  @@index([createdById])
  @@map("inventory_transactions")
}

model InventoryCostLayer {
  id                   String          @id @default(uuid()) @db.Uuid
  variantId            String?         @map("variant_id") @db.Uuid
  warehouseId          String?         @map("warehouse_id") @db.Uuid
  remainingQty         Decimal?        @map("remaining_qty") @db.Decimal(14, 4)
  unitCost             Decimal?        @map("unit_cost") @db.Decimal(14, 4)
  sourceTransactionId  String?         @map("source_transaction_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamp(6)

  variant              ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse            Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([variantId, warehouseId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("inventory_cost_layers")
}

model InventoryValuation {
  variantId     String         @map("variant_id") @db.Uuid
  warehouseId   String         @map("warehouse_id") @db.Uuid
  totalQuantity Decimal?       @map("total_quantity") @db.Decimal(14, 4)
  totalCost     Decimal?       @map("total_cost") @db.Decimal(14, 4)
  avgUnitCost   Decimal?       @map("avg_unit_cost") @db.Decimal(14, 4)

  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_valuation")
}

model CogsEntry {
  id             String             @id @default(uuid()) @db.Uuid
  saleItemId     String?            @map("sale_item_id") @db.Uuid
  variantId      String?            @map("variant_id") @db.Uuid
  quantity       Decimal?           @db.Decimal(14, 4)
  unitCost       Decimal?           @map("unit_cost") @db.Decimal(14, 4)
  totalCost      Decimal?           @map("total_cost") @db.Decimal(14, 2)
  costingMethod  CostingMethodName? @map("costing_method")
  sourceLayerId  String?            @map("source_layer_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamp(6)

  saleItem       SaleItem?          @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  variant        ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([saleItemId])
  @@index([variantId])
  @@index([createdAt])
  @@map("cogs_entries")
}
